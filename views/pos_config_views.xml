<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- POS Config Settings -->
    <record id="res_config_settings_view_form_pos_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="before">
                <block title="Purchase Orders" id="pos_purchase_section">
                    <setting id="pos_create_po" string="Create Purchase Order"
                             help="Enable creating purchase orders directly from POS">
                        <field name="create_po"/>
                        <div invisible="not create_po" class="mt-3">
                            <label for="po_state" string="PO State"/>
                            <field name="po_state" class="o_light_label"/>
                            <div class="mt-2">
                                <label for="po_vendor_id" string="Default Vendor"/>
                                <field name="po_vendor_id" class="o_light_label"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>

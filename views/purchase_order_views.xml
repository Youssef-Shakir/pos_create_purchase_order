<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Receipt Image View Form -->
    <record id="purchase_order_receipt_image_form" model="ir.ui.view">
        <field name="name">purchase.order.receipt.image.form</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <form string="Receipt Image">
                <sheet>
                    <group>
                        <field name="pos_bill_reference" readonly="1"/>
                    </group>
                    <group>
                        <field name="pos_receipt_image" widget="image" class="oe_avatar"
                               options="{'size': [600, 600]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to view Purchase Orders from POS Config -->
    <record id="action_purchase_orders_from_pos" model="ir.actions.act_window">
        <field name="name">Purchase Orders from POS</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pos_config_id', '=', active_id)]</field>
        <field name="context">{
            'search_default_pos_config_id': active_id,
            'default_pos_config_id': active_id
        }</field>
    </record>

    <!-- Extend Purchase Order Search View -->
    <record id="view_purchase_order_filter_pos" model="ir.ui.view">
        <field name="name">purchase.order.search.pos</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="From POS" name="from_pos"
                        domain="[('pos_origin', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="POS Config" name="group_pos_config"
                            context="{'group_by': 'pos_config_id'}"/>
                    <filter string="POS Origin" name="group_origin"
                            context="{'group_by': 'origin'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Add POS fields to Purchase Order Form -->
    <record id="purchase_order_form_pos" model="ir.ui.view">
        <field name="name">purchase.order.form.pos</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="pos_origin" invisible="1"/>
                <field name="pos_config_id" invisible="not pos_origin" readonly="1"/>
                <field name="pos_bill_reference" invisible="not pos_origin" readonly="1"/>
                <field name="pos_paid_with_cash" invisible="not pos_origin" readonly="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_receipt_image" type="object"
                        class="oe_stat_button" icon="fa-image"
                        invisible="not pos_receipt_image">
                    <span class="o_stat_text">Receipt Image</span>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Add POS fields to Purchase Order List -->
    <record id="purchase_order_list_pos" model="ir.ui.view">
        <field name="name">purchase.order.list.pos</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="pos_origin" column_invisible="1"/>
                <field name="pos_config_id" string="POS" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>

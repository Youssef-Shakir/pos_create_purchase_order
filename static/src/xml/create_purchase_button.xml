<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extend ControlButtons to add Create Purchase Order button -->
    <t t-name="pos_create_purchase_order.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button t-if="this.pos.config.create_po"
                    class="btn btn-secondary btn-lg py-3 control-button"
                    t-on-click="() => this.onClickCreatePurchaseOrder()">
                <i class="fa fa-truck me-1" role="img"/>
                <span>Create Purchase Order</span>
            </button>
        </xpath>
    </t>
</templates>
